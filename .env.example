# Postgres from docker-compose.yml
DATABASE_URL=postgres://pbcp:pbcp@localhost:5433/pbcp

# Signs session access tokens, enrolment links and WebAuthn state. At least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# Passkeys: the origin the sign-in page is served from, and its host as the relying party id.
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# Sign in with Apple: the Services ID and/or bundle id, comma-separated. Unset: /api/auth/apple answers 501.
# APPLE_CLIENT_ID=

# The head GET / describes when no producer token is sent. Unset: the only head in the database.
# PBCP_HEAD=morten

# Vercel Cron sends this as a bearer token to /api/cron/brief (the nightly card). Unset: the route refuses.
CRON_SECRET=change-me

# Mermaid diagrams are drawn in headless Chromium (puppeteer downloads one on install). On a platform
# without it, point at a Chromium build here.
# PBCP_CHROMIUM_PATH=
