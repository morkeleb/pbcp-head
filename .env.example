# The head's environment. Copy to .env for local work (`pnpm dev`, the scripts) and for docker compose;
# on Vercel, set the same names under Project → Settings → Environment Variables (docs/deploy.md).

# --- Database -----------------------------------------------------------------------------------------
# What the app connects with. Locally, Postgres from docker-compose.yml. On Vercel with the Neon
# integration this is set for you: Neon's *pooled* URL (the host has `-pooler`), which suits many short
# serverless connections.
DATABASE_URL=postgres://pbcp:pbcp@localhost:5433/pbcp

# What `pnpm db:migrate` connects with, when set: Neon's *direct* (unpooled) URL, also set by the
# integration. Migrations run in one long session, which a transaction pooler does not give. Unset:
# migrations use DATABASE_URL (fine for local Postgres and Docker, which have no pooler).
# DATABASE_URL_UNPOOLED=

# Vercel only, for Production and Preview: NODE_OPTIONS=--experimental-require-module. AWS Lambda's Node
# runtime, which Vercel's functions run on, otherwise switches off require() of ES modules, which jsdom's
# dependencies use; every /api/me route then fails (docs/deploy.md). Not needed locally or in Docker.

# --- Secrets ------------------------------------------------------------------------------------------
# Signs session access tokens, enrolment links, WebAuthn state, image-proxy URLs and the draw route's key.
# At least 32 characters: `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789

# Vercel Cron sends this as a bearer token to /api/cron/brief (the nightly card); docker compose's cron
# service does the same. Unset: the route refuses every call. `openssl rand -base64 32`.
CRON_SECRET=change-me

# --- Sign-in ------------------------------------------------------------------------------------------
# Passkeys: the origin the sign-in page is served from (https://<your domain> in production), and the
# relying party id, which defaults to that origin's host. Passkeys are bound to the RP id: changing the
# domain later means registering them again.
WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_RP_ID=localhost

# Sign in with Apple (optional): the Services ID and/or the app's bundle id, comma-separated.
# Unset: /api/auth/apple answers 501, and passkeys are the only way in.
# APPLE_CLIENT_ID=

# --- Rendering ----------------------------------------------------------------------------------------
# The Chromium that draws mermaid diagrams (lib/render/chromium.ts):
#   unset                puppeteer's own download (local development); on Vercel, @sparticuz/chromium
#   @sparticuz/chromium  the serverless build bundled with the draw function
#   /usr/bin/chromium    a binary on the machine (the Docker image sets this)
# PBCP_CHROMIUM_PATH=

# Run Chromium without its sandbox: only where the sandbox cannot start (containers, CI runners). The
# Docker image sets it; drawing has no network either way.
# PBCP_CHROMIUM_NO_SANDBOX=1

# Where the head sends diagrams to be drawn (POST /api/render/draw). Unset: this deployment on Vercel,
# this server on 127.0.0.1:$PORT elsewhere. Only needed behind an unusual proxy, or to try another build
# of the draw function.
# PBCP_DRAW_URL=

# --- Heads --------------------------------------------------------------------------------------------
# The head GET / describes when no producer token is sent. Unset: the only head in the database.
# PBCP_HEAD=morten

# Docker only: create this head on first start and print its enrolment link to the log (`pnpm seed`). The
# timezone is optional: set, it pins the head's day and nightly brief to that zone; unset, the head follows
# the zone of the owner's active device (X-Timezone).
# PBCP_OWNER=morten
# PBCP_TIMEZONE=Europe/Copenhagen

# --- Tests --------------------------------------------------------------------------------------------
# Opens /api/test (the head clock, the sync page cap, rate-limit overrides). The test suites start their
# own head with it; never set it anywhere else. A production deployment (VERCEL_ENV=production) refuses
# to build or start while it is set.
# PBCP_TEST_MODE=1
