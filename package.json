{
  "name": "pbcp-head",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "pnpm run build:pbcp",
    "build:pbcp": "tsc -p vendor/pbcp/packages/core/tsconfig.build.json && tsc -p vendor/pbcp/packages/client/tsconfig.build.json",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "next build && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test:unit": "vitest run --project unit",
    "mint-token": "tsx --env-file-if-exists=.env scripts/mint-token.ts",
    "revoke-token": "tsx --env-file-if-exists=.env scripts/revoke-token.ts",
    "enroll": "tsx --env-file-if-exists=.env scripts/enroll.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test:gate": "vitest run",
    "api:generate": "tsx scripts/api-generate.ts",
    "icons": "tsx scripts/icons.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@pbcp/client": "workspace:*",
    "@pbcp/core": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@sparticuz/chromium": "153.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "dompurify": "3.4.17",
    "drizzle-orm": "0.45.4",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-text": "4.0.3",
    "hastscript": "9.0.1",
    "jose": "6.2.13",
    "jsdom": "30.1.3",
    "lucide-react": "1.62.0",
    "mermaid": "12.2.0",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "puppeteer": "25.16.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "undici": "8.12.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/jsdom": "30.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.17.1",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.23.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
